APP_NAME=QUANTUM AI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Set these as private environment secrets in your hosting provider.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=

# Customer accounts: registration stays closed until explicitly enabled.
ALLOW_CUSTOMER_SIGNUP=false
QUANTUM_DB_PATH=data/quantum_ai.sqlite3

# Deriv demo-only status connector (read-only permissions recommended).
# Never commit actual credentials or tokens.
DERIV_APP_ID=
DERIV_DEMO_ACCOUNT_ID=
DERIV_DEMO_TOKEN=
QUANTUM_ADMIN_API_KEY=

# Use HTTPS in production; session cookies become Secure automatically.
