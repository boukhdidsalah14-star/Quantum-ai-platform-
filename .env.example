APP_NAME=QUANTUM AI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Set these as private environment secrets in your hosting provider.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
TELEGRAM_WEBHOOK_SECRET=

# Customer accounts: registration stays closed until explicitly enabled.
ALLOW_CUSTOMER_SIGNUP=false
QUANTUM_DB_PATH=data/quantum_ai.sqlite3

# Owner-only passwordless admin login. Configure a verified sender in Resend.
QUANTUM_ADMIN_EMAIL=smartgoomaps@gmail.com
RESEND_API_KEY=
QUANTUM_EMAIL_FROM=
QUANTUM_ADMIN_OTP_SECRET=

# Spotware cTrader Open API application credentials (register at https://connect.spotware.com).
# Use the exact HTTPS callback URL registered in the Spotware application.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://quantum-ai-iqoption-preview.onrender.com/api/connections/ctrader/callback

