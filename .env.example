APP_NAME=QUANTUM AI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Set these as private environment secrets in your hosting provider.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
TELEGRAM_WEBHOOK_SECRET=

# Customer accounts: registration stays closed until explicitly enabled.
ALLOW_CUSTOMER_SIGNUP=false
QUANTUM_DB_PATH=data/quantum_ai.sqlite3

# Deriv demo-only status connector (read-only permissions recommended).
# Never commit actual credentials or tokens.
DERIV_APP_ID=
DERIV_DEMO_ACCOUNT_ID=
DERIV_DEMO_TOKEN=
QUANTUM_ADMIN_API_KEY=


# Fernet key for encrypted customer-owned Deriv demo credentials. Generate privately; never commit it.
QUANTUM_CREDENTIALS_ENCRYPTION_KEY=
# Set true only after attaching durable persistent storage at QUANTUM_DB_PATH.
QUANTUM_PERSISTENT_STORAGE=false
# Separate kill switch. Keep false until the demo environment is fully verified.
QUANTUM_DERIV_DEMO_TRADING_ENABLED=false

# Spotware cTrader Open API application credentials (register at https://connect.spotware.com).
# Use the exact HTTPS callback URL registered in the Spotware application.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://quantum-ai-iqoption-preview.onrender.com/api/connections/ctrader/callback

# MetaApi cloud provider token for customer-owned MT4/MT5 cloud terminals.
# Keep this secret in Render Environment, never in the repository.
METAAPI_TOKEN=
